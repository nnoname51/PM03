import sqlite3
import random

DB_NAME = "shop_experiment.db"


def init_db():
    """Создает таблицы для заказов и логов нагрузки."""
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS orders (
                order_id INTEGER PRIMARY KEY AUTOINCREMENT,
                day INTEGER,
                items_count INTEGER,
                total_price REAL,
                processing_time REAL
            )
        ''')
        cursor.execute('DELETE FROM orders')
        conn.commit()


def run_shop_simulation(days, orders_per_day):
    """Вычислительный эксперимент: Моделирование случайного потока заказов."""
    print("[Магазин] Запуск симуляции потока заказов...")
    all_orders = []

    for day in range(1, days + 1):
        # Генерируем случайное число заказов в день вокруг среднего значения
        daily_count = random.randint(orders_per_day - 10, orders_per_day + 10)
        if daily_count < 0: daily_count = 0

        for _ in range(daily_count):
            # Количество товаров в одном заказе (от 1 до 10)
            items = random.randint(1, 10)
            # Цена одного товара в среднем 1500 руб + случайный разброс
            price = items * random.uniform(500, 2500)
            # Время сборки заказа зависит от количества товаров + случайная задержка
            proc_time = items * 1.5 + random.expovariate(1.0 / 2.0)

            all_orders.append((day, items, round(price, 2), round(proc_time, 2)))

    return all_orders


def save_orders_to_db(data):
    """Сохраняет сгенерированные заказы в базу данных SQLite."""
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.executemany('''
            INSERT INTO orders (day, items_count, total_price, processing_time)
            VALUES (?, ?, ?, ?)
        ''', data)
        conn.commit()
    print(f"[БД] Успешно сохранено заказов в базу: {len(data)}")


def analyze_shop_performance():
    """Анализ работы интернет-магазина стандартными средствами Python."""
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute('SELECT items_count, total_price, processing_time FROM orders')
        rows = cursor.fetchall()

    if not rows:
        print("Данные не найдены.")
        return

    # Извлекаем списки данных
    prices = [r[1] for r in rows]
    times = [r[2] for r in rows]

    # Считаем базовую аналитику
    total_revenue = sum(prices)
    avg_check = total_revenue / len(prices)
    max_time = max(times)
    avg_time = sum(times) / len(times)

    print("\n--- Результаты вычислительного эксперимента ---")
    print(f"Всего обработано заказов: {len(rows)}")
    print(f"Общая выручка магазина: {total_revenue:.2f} руб.")
    print(f"Средний чек заказа: {avg_check:.2f} руб.")
    print(f"Максимальное время сборки одного заказа: {max_time:.2f} мин.")
    print(f"Среднее время сборки заказа на складе: {avg_time:.2f} мин.")


if __name__ == "__main__":
    init_db()
    # Симулируем 30 дней, в среднем 40 заказов в день
    simulated_data = run_shop_simulation(days=30, orders_per_day=40)
    save_orders_to_db(simulated_data)
    analyze_shop_performance()
